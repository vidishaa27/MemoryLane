SECRET_KEY=replace-with-a-secure-secret
# Note: In Flask-SQLAlchemy 3, relative SQLite URLs (e.g. sqlite:///database.db)
# resolve into the backend/instance/ directory.
# To use backend/database.db, leave DATABASE_URL blank (falls back to absolute path)
# or specify the absolute path: sqlite:////absolute/path/to/backend/database.db
DATABASE_URL=

APP_ENV=development

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
